# --- Public (safe in browser) ---
NEXT_PUBLIC_SITE_URL=https://www.tokenclub.fun
# Reown (AppKit) — https://cloud.reown.com — allowlist exact origins or you may see 403/401
NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_PLATFORM_FEE_WALLET=6nZ3TZhPcr4wLYFXa5jQeSB1YYKF9tozfuxzYgGPau23
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# Optional: WSS for subscriptions (HTTP RPC uses /api/rpc; do not put API keys in NEXT_PUBLIC_ if avoidable)
# NEXT_PUBLIC_RPC_WS_MAINNET=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# NEXT_PUBLIC_RPC_WS_DEVNET=wss://devnet.helius-rpc.com/?api-key=YOUR_KEY

# Proxy toggles (default ON). Set to "false" only for local debugging.
# NEXT_PUBLIC_USE_RPC_PROXY=false
# NEXT_PUBLIC_USE_JUPITER_PROXY=false

# --- Server-only (Vercel Project → Environment Variables / .env.local — never commit real values) ---
# JSON-RPC via /api/rpc — provider: helius | alchemy | auto (default: Helius → Alchemy → public)
# RPC_PROVIDER=auto

# Helius (key only or full URL with ?api-key=)
HELIUS_API_KEY=
HELIUS_API_KEY_MAINNET=
HELIUS_API_KEY_DEVNET=

# Alchemy (key only or full /v2/... URL)
ALCHEMY_API_KEY=
ALCHEMY_API_KEY_MAINNET=
ALCHEMY_API_KEY_DEVNET=

# Jupiter (/api/jupiter proxy)
JUPITER_API_KEY=
JUPITER_API_BASE_URL=https://api.jup.ag

# Pinata (/api/pinata/*)
PINATA_JWT=

# Optional public RPC fallbacks
# RPC_URL_MAINNET=https://api.mainnet-beta.solana.com
# RPC_URL_DEVNET=https://api.devnet.solana.com
